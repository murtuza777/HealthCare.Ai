{
  "name": "Healthcare.AI",
  "short_name": "Healthcare.AI",
  "description": "A calm, careful record of your heart: readings, medicines, reminders and reports.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FAFAF9",
  "theme_color": "#FAFAF9",
  "categories": ["health", "medical"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Log a reading", "url": "/app/vitals", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Ask the assistant", "url": "/app/assistant", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
