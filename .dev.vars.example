# Copy to .dev.vars for local development. Never commit .dev.vars.
BETTER_AUTH_SECRET=generate-a-long-random-string
# Server-side secret mixed into every stored password hash. Never change it once users exist.
PASSWORD_PEPPER=generate-another-long-random-string
APP_URL=http://localhost:5173
# Local dev: keep emails (login codes) in the outbox table instead of sending them.
EMAIL_MODE=outbox
# Production needs this, or sign-in fails with "Email sign-in isn't set up yet".
RESEND_API_KEY=
# Optional: Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: Cloudflare Turnstile (bot protection). These are Cloudflare test keys that always pass.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Assistant: leave empty to use Workers AI (needs `wrangler login`); "fake" answers with fixed text (tests).
AI_MODE=

# Web Push reminders: generate with `node scripts/vapid-keys.mjs`. Leave empty to turn reminders off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
